      "to": "preturno",
      "label": "integrações + endpoints"
    },
    {
      "id": "e8",
      "from": "preturno",
      "to": "verificacoes",
      "label": "tentativa / verificado / bloqueado"
    },
    {
      "id": "e9",
      "from": "preturno",
      "to": "acoes",
      "label": "claim atômico e resultado"
    },
    {
      "id": "e10",
      "from": "preturno",
      "to": "ferramentas",
      "label": "eventos no sufixo"
    },
    {
