{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Tags e Kanban — o catálogo e a sincronia tag ↔ coluna",
    "subtitle": "a tag nasce no catálogo (nome, cor), liga-se a uma coluna; aplicar a tag põe o contato no Kanban e entrar na coluna dá a tag ao contato — nunca remove",
    "output": "tags-e-kanban.html",
    "quality_profile": "standard"
  },
  "lanes": [
    {
      "id": "tela",
      "label": "Onde a pessoa está"
    },
    {
      "id": "maquina",
      "label": "Agente, fluxo, automação"
    },
    {
      "id": "borda",
      "label": "Rotas"
    },
    {
      "id": "regra",
      "label": "Regra"
    },
    {
      "id": "dados",
      "label": "Banco"
    },
    {
      "id": "retorno",
      "label": "Laço de retorno"
    }
  ],
  "mainPath": [
    "paginaTags",
    "rotasTags",
    "catalogo",
    "vinculo",
    "patchContato",
    "regra",
    "leads",
    "quadro"
  ],
  "nodes": [
    {
      "id": "paginaTags",
      "lane": "tela",
      "col": 0,
      "type": "component",
      "label": "/app/tags",
      "sublabel": "criar, cor, renomear (funde com confirmação), arquivar; mostra uso e colunas"
    },
    {
      "id": "inbox",
      "lane": "tela",
      "col": 3,
      "type": "component",
      "label": "Inbox › painel do contato",
      "sublabel": "aplica tag do catálogo no contato"
    },
    {
      "id": "quadro",
      "lane": "tela",
      "col": 6,
      "type": "component",
      "label": "Quadro do Kanban",
      "sublabel": "arrastar card; realtime em crm_leads"
    },
    {
      "id": "mcp",
      "lane": "maquina",
      "col": 3,
      "type": "module",
      "label": "crm_manage_tags / crm_move_lead_stage",
      "sublabel": "grafia do catálogo; emite contact.tag_added"
    },
    {
      "id": "fluxo",
      "lane": "maquina",
      "col": 4,
      "type": "module",
      "label": "bloco crm.add_tag",
      "sublabel": "marcar lead vale o contato dele"
    },
    {
      "id": "automacao",
      "lane": "maquina",
      "col": 5,
      "type": "module",
      "label": "ação create_or_move_lead",
      "sublabel": "procura o negócio aberto antes de criar"
    },
    {
      "id": "rotasTags",
      "lane": "borda",
      "col": 1,
      "type": "route",
      "label": "/api/v1/tags (+ /[id])",
      "sublabel": "viewer lê, manager escreve"
    },
    {
      "id": "rotaColuna",
      "lane": "borda",
      "col": 2,
      "type": "route",
      "label": "PUT /pipelines/[id]/stages/[stageId]/tags",
      "sublabel": "409 se a tag já está em outra coluna do Kanban"
    },
    {
      "id": "patchContato",
      "lane": "borda",
      "col": 3,
      "type": "route",
      "label": "PATCH /api/v1/contacts/[id]",
      "sublabel": "devolve kanban_efeitos para a tela"
    },
    {
      "id": "rotaMove",
      "lane": "borda",
      "col": 5,
      "type": "route",
      "label": "POST /api/v1/leads/[id]/move",
      "sublabel": "só ao trocar de coluna"
    },
    {
      "id": "regra",
      "lane": "regra",
      "col": 4,
      "type": "module",
      "label": "lib/tags/tag-no-kanban",
      "sublabel": "aplicarTagsNoKanban / aplicarTagDaColuna (um salto)"
    },
    {
      "id": "operacoes",
      "lane": "regra",
      "col": 1,
      "type": "module",
      "label": "lib/tags/operacoes",
      "sublabel": "sem duplicata por caixa; fusão pedida"
    },
    {
      "id": "catalogo",
      "lane": "dados",
      "col": 1,
      "type": "table",
      "label": "crm_tags",
      "sublabel": "nome exato único; trigger registra nome novo de contato/lead"
    },
    {
      "id": "vinculo",
      "lane": "dados",
      "col": 2,
      "type": "table",
      "label": "crm_stage_tags",
      "sublabel": "uma coluna por Kanban; FK composta (pipeline, stage)"
    },
    {
      "id": "renomear",
      "lane": "dados",
      "col": 0,
      "type": "service",
      "label": "fn_renomear_tag",
      "sublabel": "propaga para contacts/crm_leads/conversations; só service_role"
    },
    {
      "id": "leads",
      "lane": "dados",
      "col": 5,
      "type": "table",
      "label": "crm_leads / contacts.tags",
      "sublabel": "cria ou move; tag acrescentada ao contato"
    },
    {
      "id": "timeline",
      "lane": "retorno",
      "col": 5,
      "type": "component",
      "label": "Timeline do lead + audit",
      "sublabel": "\"Entrou em Proposta pela tag VIP\"; lead.moved / tag.* / stage.tags_changed"
    },
    {
      "id": "aviso",
      "lane": "retorno",
      "col": 3,
      "type": "module",
      "label": "Efeito ambíguo/falhou",
      "sublabel": "dois negócios abertos no Kanban: não adivinha, a tela avisa"
    },
    {
      "id": "rotaColunasDaTag",
      "lane": "borda",
      "col": 2,
      "type": "route",
      "label": "PUT /api/v1/tags/[id]/colunas",
      "sublabel": "uma coluna por Kanban, escolhida na página de Tags"
    },
    {
      "id": "rotaContatoKanban",
      "lane": "borda",
      "col": 4,
      "type": "route",
      "label": "GET/POST /api/v1/contacts/[id]/kanbans",
      "sublabel": "inbox: em que coluna de cada Kanban; colocar move ou cria"
    },
    {
      "id": "contatoNoKanban",
      "lane": "regra",
      "col": 3,
      "type": "module",
      "label": "lib/leads/contato-no-kanban",
      "sublabel": "move o negócio aberto ou cria; 409 se ambíguo"
    },
    {
      "id": "configurar",
      "lane": "tela",
      "col": 5,
      "type": "component",
      "label": "Painel Configurar do Kanban",
      "sublabel": "colunas, ganho/perda, passo do agente, campos e nomes — ex-página Colunas dos Kanbans"
    }
  ],
